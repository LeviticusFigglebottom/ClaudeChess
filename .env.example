# --- Supabase (Phase 0: wiring only; required once auth/persistence land) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Supabase → Project Settings → Database).
# Used by Drizzle (drizzle-kit migrate + server-side queries).
DATABASE_URL=

# --- Anthropic (Phase 2+: /api/coach, /api/classify-blunder; server-side only) ---
ANTHROPIC_API_KEY=

# --- Accounts (Phase 1.5) ---
# Admin allowlist for B1.3 (comma-separated Supabase auth user UUIDs).
# Admins can grant/revoke FIDE-style titles via POST /api/admin/title.
ADMIN_USER_IDS=
# Bearer secret for Vercel Cron routes (/api/cron/purge-deleted).
CRON_SECRET=

# --- Feature flags (spec §9) — original trainers, default OFF ---
NEXT_PUBLIC_FF_CALIBRATION=0
NEXT_PUBLIC_FF_FINGERPRINT=0
NEXT_PUBLIC_FF_TEMPO=0
NEXT_PUBLIC_FF_REPERTOIRE=0
NEXT_PUBLIC_FF_POSTMORTEM=0
NEXT_PUBLIC_FF_MAIA=0
